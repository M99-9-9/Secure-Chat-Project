{
  "version": "1.0.0",
  "projectName": "Secure-Chat-Project",
  "description": "تطبيق دردشة آمن قائم على Element",
  "buildConfiguration": {
    "buildCommand": "pnpm install && pnpm --filter=@element-hq/web build",
    "outputDirectory": "apps/web/webapp",
    "framework": "other",
    "environment": {
      "CI": "true"
    }
  },
  "deployment": {
    "provider": "vercel",
    "regions": ["default"],
    "previewDeployments": true
  },
  "performance": {
    "caching": {
      "default": "public, max-age=3600, must-revalidate",
      "html": "no-cache, must-revalidate"
    },
    "security": {
      "noSniff": true,
      "frameOptions": "SAMEORIGIN"
    }
  },
  "workspace": {
    "type": "monorepo",
    "packageManager": "pnpm",
    "workspaces": [
      "apps/web",
      "packages/*"
    ]
  },
  "apiConfiguration": {
    "functions": {
      "api/**/*.ts": {
        "memory": 1024,
        "maxDuration": 30
      }
    },
    "rewrites": [
      {
        "source": "/:path*",
        "destination": "/index.html"
      }
    ]
  },
  "diagnostics": {
    "projectStructure": {
      "monorepo": true,
      "packageManager": "pnpm",
      "workspaceConfig": "pnpm-workspace.yaml",
      "outputPath": "apps/web/webapp",
      "buildTool": "nx + webpack"
    },
    "dependencies": {
      "totalPackages": "monorepo",
      "rootPackageName": "element-web-monorepo",
      "webAppPackageName": "element-web",
      "webAppFilter": "@element-hq/web"
    }
  },
  "buildStatus": {
    "lastBuild": "2026-04-03T00:00:00Z",
    "lastError": null,
    "status": "fixed",
    "fixSummary": "تم إصلاح خطأ NOT_FOUND بتصحيح أمر البناء في vercel.json و visual.json"
  },
  "fixes": {
    "buildCommand": {
      "before": "cd apps/web && pnpm install && pnpm build",
      "after": "pnpm install && pnpm --filter=@element-hq/web build",
      "reason": "تثبيت جميع تبعيات مساحة العمل من الجذر قبل البناء"
    }
  },
  "notes": {
    "ar": "✅ تم إصلاح خطأ البناء NOT_FOUND. أمر البناء يقوم الآن بـ:\n1. تثبيت جميع الحزم من الجذر (pnpm install)\n2. بناء تطبيق Element Web (pnpm --filter=@element-hq/web build)\n3. النشر تلقائياً على Vercel",
    "en": "✅ NOT_FOUND build error fixed. Build command now:\n1. Installs all root workspace packages (pnpm install)\n2. Builds Element Web app (pnpm --filter=@element-hq/web build)\n3. Auto-deploys to Vercel"
  }
}
